{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludo-shakti",
  "compatibility_date": "2026-09-26",
  "main": "worker.js",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
